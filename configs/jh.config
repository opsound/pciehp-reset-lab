# Jailhouse guest support on top of linux-x86_64.config.  With QEMU's
# "-cpu host,hv-vendor-id=Jailhouse" (harness/run.py, the isolfn scenario) the
# guest sees Jailhouse's CPUID signature, so hypervisor_isolated_pci_functions()
# is true and pci_scan_slot() scans functions 1-7 of a slot without function 0,
# as on s390, LoongArch and Jailhouse.  Without that signature it is inert.
CONFIG_JAILHOUSE_GUEST=y
